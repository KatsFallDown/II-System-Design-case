DATASET_PATH=./dataset-tickets-multi-lang-4-20k.csv
LLM_MODE=llama_cpp # llama_cpp | mock

# llama.cpp: place this file inside LLAMA_MODELS_DIR.
LLAMA_MODELS_DIR=./models
LLAMA_MODEL_FILE=Qwen3.5-4B-Q8_0.gguf
LLAMA_MODEL=Qwen3.5-4B-Q8_0.gguf
LLAMA_BASE_URL=http://llama-cpu:8080
LLAMA_TIMEOUT_SECONDS=45
LLAMA_CTX_SIZE=4096
LLAMA_THREADS=8

# GPU profile: set URL to llama-gpu and tune layers if partial offload is needed.
LLAMA_GPU_LAYERS=99
LLAMA_SPLIT_MODE=layer

CATEGORY_CONFIDENCE_THRESHOLD=0.65
RISK_CONFIDENCE_THRESHOLD=0.60
RETRIEVAL_SIMILARITY_THRESHOLD=0.25
